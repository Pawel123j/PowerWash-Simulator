    branchNodeId: ch_krakow
    nextNodeId: ch_home_plain
  - nodeId: ch_krakow
    lines:
    - speakerId: kuba_thought
      language: 0
      text: "Krak\xF3w. Hotel przy Rynku, zast\u0119pca szefa kuchni, z certyfikatem z Cathal Brugha Street. Wyjecha\u0142em jako filozof, wracam jako kucharz."
    teachVocabularyWords: []
    unlockSlangIds: []
    setFlags: []
    outcome:
      moneyEuros: 0
      energy: 0
      homesickness: -20
      integration: 0
    choices: []
    branchIfFlag: 
    branchNodeId: 
    nextNodeId: ch_end
  - nodeId: ch_home_plain
    lines:
    - speakerId: kuba_thought
      language: 0
      text: "Wracam. Bez planu. Z dyplomem z filozofii i r\u0119kami, kt\xF3re umiej\u0105 zmywa\u0107 i kroi\u0107. Na pocz\u0105tek wystarczy."
    teachVocabularyWords: []
    unlockSlangIds: []
    setFlags: []
    outcome:
      moneyEuros: 0
      energy: 0
      homesickness: -20
      integration: 0
    choices: []
    branchIfFlag: 
    branchNodeId: 
    nextNodeId: ch_end
  - nodeId: ch_perth
    lines:
    - speakerId: gavin
      language: 1
      text: Deadly. Bring your plasters. And sun cream.
    - speakerId: kuba_thought
      language: 0
      text: "Australia. Jeszcze dalej od domu. Albo jeszcze bli\u017Cej siebie. Syzyf nigdy nie m\xF3g\u0142 zmieni\u0107 g\xF3ry. Ja mog\u0119."
    teachVocabularyWords:
    - cream
    - sun
    unlockSlangIds: []
    setFlags:
    - ch5_goes_to_perth
