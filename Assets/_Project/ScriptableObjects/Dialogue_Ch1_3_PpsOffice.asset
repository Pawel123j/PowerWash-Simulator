    nextNodeId: pps_clerk
  - nodeId: pps_clerk
    lines:
    - speakerId: clerk
      language: 1
      text: PPS number? Grand. I'll need your passport and a proof of address. A bill or a bank statement with your name on it.
    - speakerId: kuba_thought
      language: 0
      text: "Rachunek z moim nazwiskiem. W domu, w kt\xF3rym moje nazwisko nie istnieje."
    - speakerId: clerk
      language: 1
      text: No address, no PPS, I'm afraid. Next!
    teachVocabularyWords:
    - number
    - passport
    - address
    - bill
    - bank
    - name
    - afraid
    - next
    unlockSlangIds: []
    setFlags: []
    outcome:
      moneyEuros: 0
      energy: 0
      homesickness: 0
      integration: 0
    choices: []
    branchIfFlag: 
    branchNodeId: 
    nextNodeId: pps_end
  - nodeId: pps_end
    lines:
    - speakerId: kuba_thought
      language: 0
      text: "Dobrze. Rachunku nie mam, ale bank mo\u017Ce wyda\u0107 wyci\u0105g. Jutro bank."
