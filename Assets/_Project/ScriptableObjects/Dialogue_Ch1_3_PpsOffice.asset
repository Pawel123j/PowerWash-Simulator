  m_Name: Dialogue_Ch1_3_PpsOffice
  m_EditorClassIdentifier: Zmywak.Narrative::Zmywak.Narrative.Dialogue.DialogueGraph
  startNodeId: pps_1
  nodes:
  - nodeId: pps_1
    lines:
    - speakerId: narrator
      language: 0
      text: "Urz\u0105d, okienko od numer\xF3w PPS. Kolejka od drzwi. Numerek 247, na tablicy 112."
    - speakerId: kuba_thought
      language: 0
      text: "Marek t\u0142umaczy: bez numeru PPS nie ma podatk\xF3w, bez podatk\xF3w nie ma legalnej pracy, a bez legalnej pracy Declan p\u0142aci pod sto\u0142em i w ka\u017Cdej chwili mo\u017Ce przesta\u0107."
    teachVocabularyWords: []
