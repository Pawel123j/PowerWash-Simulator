    lines: []
    teachVocabularyWords: []
    unlockSlangIds: []
    setFlags: []
    outcome:
      moneyEuros: 0
      energy: 0
      homesickness: 0
      integration: 0
    choices:
    - choiceText: "Zapisuj\u0119 si\u0119. Osiemdziesi\u0105t euro."
      targetNodeId: sc_yes
      requiredFlag: 
    - choiceText: "Dzi\u0119kuj\u0119, ale nie teraz."
      targetNodeId: sc_no
      requiredFlag: 
    branchIfFlag: 
    branchNodeId: 
    nextNodeId: 
  - nodeId: sc_yes
    lines:
    - speakerId: narrator
      language: 0
      text: "Formularz po angielsku, w trzech egzemplarzach. Kuba wype\u0142nia go sam, bez Agnieszki. W rubryce \"Previous education\" wpisuje: Master of Arts, Philosophy."
    - speakerId: kuba_thought
      language: 0
      text: "Pierwszy raz od dw\xF3ch lat kto\u015B pyta o m\xF3j dyplom. W formularzu na kurs gotowania."
    teachVocabularyWords: []
    unlockSlangIds: []
    setFlags:
    - ch4_cookery_school
    outcome:
      moneyEuros: -80
      energy: -5
      homesickness: 0
      integration: 0
    choices: []
