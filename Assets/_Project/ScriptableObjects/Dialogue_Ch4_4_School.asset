    nextNodeId: 
  - nodeId: sc_no
    lines:
    - speakerId: declan
      language: 1
      text: Your call. The offer stands till September.
    - speakerId: kuba_thought
      language: 0
      text: "Dwana\u015Bcie godzin w kuchni i jeszcze szko\u0142a. Mo\u017Ce za rok. Za rok zawsze jest wi\u0119cej czasu. Przynajmniej teraz tak si\u0119 wydaje."
    teachVocabularyWords:
