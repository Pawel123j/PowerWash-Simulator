  - nodeId: way_boston
    lines:
    - speakerId: declan
      language: 1
      text: Boston, eighty-six. Same story, different stamps. An old cook wrote me a letter. So now I write letters, son. That's how it works.
    - speakerId: kuba_thought
      language: 0
      text: "Ka\u017Cdy kiedy\u015B od tego zaczyna\u0142. Nawet Declan. Zw\u0142aszcza Declan."
    teachVocabularyWords:
    - story
    - different
    - stamps
    - old
    - cook
    - son
    - works
    unlockSlangIds: []
    setFlags:
    - ch1_declan_letter
    - ch1_declan_story
    outcome:
      moneyEuros: 0
      energy: 0
      homesickness: -5
      integration: 15
    choices: []
    branchIfFlag: 
    branchNodeId: 
    nextNodeId: way_end
  - nodeId: way_end
    lines:
    - speakerId: kuba_thought
      language: 0
      text: "Jutro znowu urz\u0105d. Numerek 247, podej\u015Bcie drugie."
