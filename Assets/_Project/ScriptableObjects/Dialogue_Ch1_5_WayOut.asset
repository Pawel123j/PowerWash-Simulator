    nextNodeId: way_end
  - nodeId: way_fake_bill
    lines:
    - speakerId: marek
      language: 0
      text: "M\u0105dry wyb\xF3r. Jutro b\u0119dziesz mia\u0142 naj\u0142adniejszy rachunek w Dublinie."
    - speakerId: kuba_thought
      language: 0
      text: "Czuj\u0119 si\u0119, jakbym podpisywa\u0142 co\u015B, czego nie przeczyta\u0142em."
    teachVocabularyWords: []
    unlockSlangIds: []
    setFlags:
    - ch1_fake_bill
    outcome:
      moneyEuros: -20
      energy: 0
      homesickness: 0
      integration: 0
