  m_Name: Dialogue_Ch1_5_WayOut
  m_EditorClassIdentifier: Zmywak.Narrative::Zmywak.Narrative.Dialogue.DialogueGraph
  startNodeId: way_1
  nodes:
  - nodeId: way_1
    lines:
    - speakerId: narrator
      language: 0
      text: "Po zmianie. Kuba siedzi na skrzynce po pomidorach za restauracj\u0105 i gapi si\u0119 na formularz PPS."
    - speakerId: marek
      language: 0
      text: "S\u0142uchaj, znam go\u015Bcia. Za dwadzie\u015Bcia euro zrobi ci rachunek za pr\u0105d na twoje nazwisko. Wygl\u0105da jak prawdziwy, nikt nie sprawdza."
    - speakerId: declan
      language: 1
      text: What's that face? Ah, the PPS. Everyone has that problem. Give me the form.
    - speakerId: declan
      language: 1
      text: I'll write you a letter. You work here, you get your letters here. The office knows me.
    - speakerId: kuba_thought
      language: 0
      text: "Dwie drogi. Go\u015B\u0107 Marka jest szybki. Declan jest... Declanem."
    teachVocabularyWords:
    - face
    - form
    - letter
    - work
    - office
    - knows
    unlockSlangIds: []
    setFlags: []
    outcome:
      moneyEuros: 0
      energy: 0
      homesickness: 0
      integration: 0
    choices:
    - choiceText: "Bior\u0119 list od Declana."
      targetNodeId: way_letter
      requiredFlag: 
    - choiceText: "P\u0142ac\u0119 go\u015Bciowi Marka za rachunek."
      targetNodeId: way_fake_bill
      requiredFlag: 
    - choiceText: "(My\u015Bl o Syzyfie) Pytam Declana, kto jemu pom\xF3g\u0142 w Bostonie."
      targetNodeId: way_boston
      requiredFlag: ch1_sisyphus
    branchIfFlag: 
    branchNodeId: 
    nextNodeId: 
  - nodeId: way_letter
    lines:
    - speakerId: declan
      language: 1
      text: Good man. Now go, table six wants plates, not paperwork.
    teachVocabularyWords: []
    unlockSlangIds: []
    setFlags:
    - ch1_declan_letter
    outcome:
      moneyEuros: 0
      energy: 0
      homesickness: 0
      integration: 10
    choices: []
    branchIfFlag: 
