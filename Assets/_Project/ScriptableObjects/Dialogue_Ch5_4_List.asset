    nextNodeId: 
  - nodeId: li_quiet
    lines:
    - speakerId: narrator
      language: 0
      text: "W pi\u0105tek na grafiku brakuje dw\xF3ch nazwisk."
    - speakerId: kuba_thought
      language: 0
      text: "Ka\u017Cdy ma swoje rachunki. Powtarzam to sobie przez ca\u0142\u0105 zmian\u0119. Z ka\u017Cdym razem brzmi gorzej."
    teachVocabularyWords: []
    unlockSlangIds: []
