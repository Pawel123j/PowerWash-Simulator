  startNodeId: number_1
  nodes:
  - nodeId: number_1
    lines:
    - speakerId: narrator
      language: 0
      text: "Ta sama kolejka, ta sama urz\u0119dniczka, ten sam numerek. Inny papier w r\u0119ku."
